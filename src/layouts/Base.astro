---
// The document shell shared by every page: head, font preload, skip link.
import '../styles/tokens.css';
import '../styles/global.css';
import { site } from '../config/site';

interface Props {
  /** Page title without the brand; " | <brand>" is added here. */
  title: string;
  description: string;
  /** Prospect pages and /thanks/: no canonical, no Open Graph, kept out of search. */
  noindex?: boolean;
  structuredData?: Record<string, unknown>[];
}

const { title, description, noindex = false, structuredData = [] } = Astro.props;
const fullTitle = `${title} | ${site.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const analyticsToken = site.analytics.cloudflareToken;
// JSON-LD sits inside <script>, so "<" must never close it early.
const jsonLd = (data: unknown) => JSON.stringify(data).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="preload" href="/fonts/archivo.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#f1f3ee" />
    {
      noindex ? (
        <meta name="robots" content="noindex, nofollow" />
      ) : (
        <>
          <link rel="canonical" href={canonical} />
          <meta property="og:type" content="website" />
          <meta property="og:site_name" content={site.name} />
          <meta property="og:title" content={title} />
          <meta property="og:description" content={description} />
          <meta property="og:url" content={canonical} />
          <meta property="og:locale" content="en_US" />
          <meta name="twitter:card" content="summary" />
        </>
      )
    }
    {structuredData.map((data) => <script is:inline type="application/ld+json" set:html={jsonLd(data)} />)}
    {
      analyticsToken && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: analyticsToken })}
        />
      )
    }
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
  </body>
</html>
