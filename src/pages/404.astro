---
import BookingButton from '../components/BookingButton.astro';
import TextLink from '../components/TextLink.astro';
import Page from '../layouts/Page.astro';
---

<Page title="Page not found" description="This page isn't here." page="404" noindex>
  <section class="section page-intro not-found" aria-labelledby="intro-title">
    <div class="flow intro-text">
      <h1 id="intro-title">This page isn’t here</h1>
      <p class="lead">The link may be out of date, or the address may have a typo.</p>
      <div class="actions intro-actions">
        <BookingButton content="404" />
      </div>
      <p>
        <TextLink href="/" standalone>Go to the home page</TextLink>
      </p>
    </div>
  </section>
</Page>

<style>
  .not-found {
    padding-bottom: var(--space-9);
  }
</style>
