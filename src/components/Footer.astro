---
import { site } from '../config/site';
import { formatMoney } from '../lib/text';

interface Props {
  /** Prospect pages say that opens are logged, when the visit logger is on. */
  visitLogNotice?: boolean;
}

const { visitLogNotice = false } = Astro.props;

const links = [
  { href: '/about/', label: 'About' },
  { href: '/contact/', label: 'Contact' },
  { href: '/privacy/', label: 'Privacy' },
  { href: '/terms/', label: 'Terms' },
  { href: '/service-terms/', label: 'Service terms' },
];
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap">
    <div class="grid footer-grid">
      <div class="span-5 flow">
        <p class="footer-name">{site.name}</p>
        <p class="small">
          {site.offer.name}: Google Ads management for small US businesses, {formatMoney(site.offer.price)} a month.
        </p>
      </div>
      <nav class="span-3" aria-label="Footer">
        <ul class="footer-links" role="list">
          {
            links.map(({ href, label }) => (
              <li>
                <a href={href}>{label}</a>
              </li>
            ))
          }
        </ul>
      </nav>
      <div class="span-4 flow">
        <p class="small muted">Postal address</p>
        <address class="small">{site.contact.address}</address>
      </div>
    </div>
    <div class="footer-base small">
      <p>Independent. Not affiliated with or endorsed by Google.</p>
      {
        visitLogNotice && (
          <p>This page notes when it’s opened and when the booking button is used, without cookies or personal data.</p>
        )
      }
      <p class="muted">© {year} {site.name}</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: var(--space-7) var(--space-8);
    border-top: var(--hairline) solid var(--rule);
  }

  .footer-grid {
    --flow-space: var(--space-2);
    row-gap: var(--space-6);
  }

  .footer-name {
    font-weight: 800;
    font-stretch: var(--wide-display);
  }

  .footer-links {
    list-style: none;
    padding: 0;
    margin-top: calc(-1 * (var(--tap) - var(--body-leading)) / 2);
  }

  .footer-links a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
  }

  .footer-base {
    display: grid;
    gap: var(--space-2);
    margin-top: var(--space-6);
    padding-top: var(--space-4);
    border-top: var(--hairline) solid var(--rule);
  }
</style>
