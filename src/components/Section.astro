---
// One page section: an H2, an optional intro, then content. Sections are separated by a single
// ruled line (see .section in global.css).
interface Props {
  id: string;
  title: string;
  intro?: string;
  class?: string;
}

const { id, title, intro, class: className } = Astro.props;
---

<section class:list={['section', className]} id={id} aria-labelledby={`${id}-title`}>
  <div class="section-head flow">
    <h2 id={`${id}-title`}>{title}</h2>
    {intro && <p class="lead">{intro}</p>}
    <slot name="intro" />
  </div>
  <slot />
</section>
