---
// A real sequence, numbered 1 to 4 at most. The ordered list carries the numbering for
// screen readers; the large numerals are visual only.
interface Props {
  steps: { title: string; text: string }[];
}

const { steps } = Astro.props;
if (steps.length < 2 || steps.length > 4) throw new Error('Steps takes 2 to 4 steps');
---

<ol class="steps" role="list" style={`--count: ${steps.length}`}>
  {
    steps.map((step, i) => (
      <li class="step">
        <span class="step-num num" aria-hidden="true">
          {i + 1}
        </span>
        <h3 class="step-title">{step.title}</h3>
        <p>{step.text}</p>
      </li>
    ))
  }
</ol>

<style>
  .steps {
    display: grid;
    gap: var(--space-6) var(--gutter);
    list-style: none;
    padding: 0;
  }

  @media (min-width: 48rem) {
    .steps {
      grid-template-columns: repeat(var(--count), minmax(0, 1fr));
    }
  }

  .step {
    display: grid;
    align-content: start;
    gap: var(--space-2);
    padding-top: var(--space-4);
    border-top: var(--ink-line) solid var(--ink);
  }

  .step-num {
    font-size: var(--h2-size);
    line-height: var(--h2-leading);
    font-weight: 800;
    font-stretch: var(--wide-display);
    margin-bottom: var(--space-2);
  }
</style>
