---
// A sample of the one-page monthly report, labelled "Sample". The figures are left blank on
// purpose: the site never shows made-up numbers. The changes match the example service log.
import PaperTag from './PaperTag.astro';

const figures = ['Spent this month', 'Calls from your ads', 'Form fills from your ads', 'Cost per call or form', 'Change from last month'];

const parts = [
  {
    title: 'What changed',
    items: [
      'Added negative keywords for job-seeker and DIY searches.',
      'Paused keywords that got clicks but no calls.',
      'Fixed form tracking after a website update.',
      'Added Saturday hours to the ads, as you asked.',
    ],
  },
  {
    title: 'What’s next',
    items: [
      'Test a headline about same-day service against the current one.',
      'Check whether evening calls are worth a higher bid.',
    ],
  },
  {
    title: 'What we need from you',
    items: ['Your holiday hours, so the ads can match them.'],
  },
];
---

<figure class="report">
  <figcaption class="report-head">
    <span class="report-title">Monthly report, March</span>
    <PaperTag kind="label">Sample</PaperTag>
  </figcaption>
  <p class="report-note">One page, in plain English. Your real figures go in the blanks, straight from your account.</p>

  <div class="report-part">
    <h3 class="report-part-title">The figures</h3>
    <dl class="figures">
      {
        figures.map((label) => (
          <div class="figure">
            <dt>{label}</dt>
            <dd>
              <span class="blank" />
              <span class="sr-only">left blank in this sample</span>
            </dd>
          </div>
        ))
      }
    </dl>
  </div>

  {
    parts.map(({ title, items }) => (
      <div class="report-part">
        <h3 class="report-part-title">{title}</h3>
        <ul class="report-list">
          {items.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </div>
    ))
  }
</figure>

<style>
  .report {
    max-width: 44rem;
    background: var(--white);
    border-top: var(--ink-line) solid var(--ink);
    border-radius: var(--radius-log);
    padding: var(--space-5) var(--space-4) var(--space-6);
  }

  @media (min-width: 48rem) {
    .report {
      padding: var(--space-6) var(--space-7) var(--space-7);
    }
  }

  .report-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2) var(--space-4);
  }

  .report-title {
    font-size: var(--h3-size);
    line-height: var(--h3-leading);
    font-weight: 700;
  }

  .report-note {
    margin-top: var(--space-1);
    color: var(--moss);
    font-size: var(--small-size);
    line-height: var(--small-leading);
  }

  .report-part {
    margin-top: var(--space-6);
    padding-top: var(--space-4);
    border-top: var(--hairline) solid var(--rule);
  }

  .report-part-title {
    font-size: var(--body-size);
    line-height: var(--body-leading);
    font-weight: 700;
    margin-bottom: var(--space-2);
  }

  .figure {
    display: flex;
    align-items: baseline;
    gap: var(--space-4);
    padding-block: var(--space-2);
  }

  .figure dt {
    flex: none;
    min-width: 12rem;
  }

  .figure dd {
    flex: 1;
  }

  /* A ruled blank, like a form waiting to be filled in */
  .blank {
    display: block;
    height: 1.25rem;
    border-bottom: var(--hairline) solid var(--moss);
  }

  .report-list {
    padding-left: 1.25rem;
  }

  .report-list li + li {
    margin-top: var(--space-2);
  }

  @media (width < 30rem) {
    .figure {
      flex-direction: column;
      gap: 0;
    }

    .figure dt {
      min-width: 0;
    }

    .figure dd {
      width: 100%;
    }
  }
</style>
