// Cloudflare Workers, static assets only: no Worker script runs.
// Deploy with `npm run deploy` (builds first). Headers come from public/_headers.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ads-site",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    // /pricing redirects to /pricing/, matching trailingSlash: 'always'.
    "html_handling": "auto-trailing-slash",
    // Unknown paths get dist/404.html with a 404 status.
    "not_found_handling": "404-page"
  }
  // TODO(owner): once the domain is picked, add it as a custom domain, e.g.
  // "routes": [{ "pattern": "example.com", "custom_domain": true }]
  // and add a Cloudflare redirect rule from www to the apex domain (see README).
}
